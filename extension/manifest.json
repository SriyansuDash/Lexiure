{
  "manifest_version": 3,
  "name": "Lexiure",
  "version": "1.1.0",
  "description": "Send files between your phone and this computer, and track screen time per website.",
  "action": {
    "default_title": "Lexiure",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "downloads", "tabs", "idle", "alarms"],
  "host_permissions": [
    "https://lexiure.onrender.com/*",
    "https://speed.cloudflare.com/*"
  ]
}